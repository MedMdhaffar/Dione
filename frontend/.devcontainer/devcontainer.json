{
	"name": "Dione Dev Container",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile"
	},
	"postCreateCommand": "npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance"
			],
			"settings": {
				"python.formatting.provider": "black",
				"python.linting.enabled": true,
				"python.linting.pylintEnabled": true
			}
		}
	},
	"remoteUser": "root"
}